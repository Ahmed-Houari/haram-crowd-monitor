# Public 24/7 Makkah live stream (YouTube page URL; yt-dlp resolves it to HLS)
STREAM_URL=https://www.youtube.com/watch?v=eC4LfEVxvKg

# Automatic fallback when YouTube fails: SBA's own HLS stream of the same broadcast (720p)
FALLBACK_HLS_URL=http://m.live.net.sa:1935/live/quran/playlist.m3u8

# TomTom developer key (step 5, Traffic Flow tiles)
TOMTOM_API_KEY=

# Optional, OFF by default (user decision): YouTube cookies for yt-dlp if YouTube keeps asking
# "Sign in to confirm you're not a bot". Use a secondary Google account. Set only one.
# On Windows use Firefox: Chrome/Edge/Brave cookies cannot be decrypted by yt-dlp
# (app-bound encryption, yt-dlp issue #10927).
# YTDLP_COOKIES_BROWSER=firefox
# YTDLP_COOKIES_FILE=C:\path\outside\repo\cookies.txt

# Database (SQLAlchemy URL). Default: SQLite file data/haram.db (relative to the project root).
# Later PostgreSQL/TimescaleDB: DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/haram
# DATABASE_URL=sqlite:///data/haram.db
